# corpus run checkpoints — regenerated by scripts/corpus_run.py
# Raw checkpoints and run logs are regenerated by scripts/corpus_run.py.
# The gzipped snapshot IS shipped: it is what makes docker compose up
# boot already populated with no API key, and a blanket ignore here
# silently broke that promise for anyone cloning the repository.
evals/corpus/*
!evals/corpus/*.jsonl.gz

# eval reports are regenerated; keep only the latest for reference
evals/reports/2*.json


FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/storage/hf

WORKDIR /app

# System deps kept deliberately thin. PyMuPDF ships manylinux wheels, so there
# is no build toolchain here — this is a large part of why the image stays small
# and `docker compose up` is fast for a reviewer. See docs/adr/0004.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY core ./core
COPY api ./api

RUN pip install --upgrade pip && pip install -e ".[dev]"

RUN mkdir -p /app/storage

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

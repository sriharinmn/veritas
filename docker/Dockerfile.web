# The reviewer's copy of the app: built, not a dev server.
#
# Two things about this file are load-bearing and were both wrong before a real
# `docker compose up` was ever run.
#
# **`scripts/` is copied before `npm install`.** package.json has a postinstall
# hook that copies react-pdf's own pdf.js worker into public/ — the fix for the
# version mismatch that made every evidence pane fail. Installing with only the
# manifests present meant the hook ran against a directory that did not exist
# yet, and the build died at `npm install` with nothing but "command failed".
#
# **The API's address is a build argument, not an environment variable.**
# `NEXT_PUBLIC_*` is inlined into the client bundle when the app is compiled, so
# passing it at run time reaches a production build too late — it would silently
# fall back to the default and the browser would call the wrong port. Compose
# passes it as an arg for exactly this reason.

FROM node:22-slim AS build

WORKDIR /app

# Manifests and the postinstall script together, so the hook has what it needs.
COPY web/package.json web/package-lock.json* ./
COPY web/scripts ./scripts
RUN npm ci || npm install

COPY web/ ./

# Baked into the client bundle at compile time. Defaults to the port compose
# publishes, so a plain `docker build` still produces a working image.
ARG NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build


FROM node:22-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/next.config.ts ./next.config.ts

EXPOSE 3000

CMD ["npx", "next", "start", "--hostname", "0.0.0.0", "--port", "3000"]

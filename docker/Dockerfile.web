FROM node:22-slim

WORKDIR /app

COPY web/package.json web/package-lock.json* ./
RUN npm install

COPY web/ ./

EXPOSE 3000

# Dev server during the build phase: hot reload matters more than start-up time
# while the UI is being built. Swapped for `next build && next start` before the
# snapshot image is cut.
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]

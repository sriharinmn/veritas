# ─────────────────────────────────────────────────────────────────────────────
# Veritas — copy to .env and fill in. NOTHING here is required to run the demo.
#
#   docker compose up   →  boots with a pre-computed knowledge layer over the
#                          six starter PDFs. No API key. No GPU. No waiting.
#
# You only need a provider below if you want to ingest YOUR OWN PDFs.
# ─────────────────────────────────────────────────────────────────────────────

# ── TIER 1 · Groq (recommended for documents under ~20 pages) ────────────────
# Free key, 60 seconds, no card: https://console.groq.com/keys
# Free tier is 30 req/min, 1000 req/day, 8k tokens/min, 200k tokens/day.
# That is ample for interactive use and NOT enough for bulk ingest — which is
# exactly why this repo ships a pre-computed snapshot instead of asking you to
# spend your quota reproducing it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── TIER 2 · Ollama (recommended for large documents; needs a local GPU) ─────
# Install from https://ollama.com, then:  ollama pull qwen3:8b
# Runs on your host, not in Docker. From inside the containers the host is
# reachable as host.docker.internal.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# ── TIER 3 · Deterministic ───────────────────────────────────────────────────
# If neither of the above is reachable the app still runs, with rule-based
# extraction only. Recall is materially lower and the UI says so, loudly.
# Nothing to configure.

# ── Optional alternatives ────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Infrastructure (defaults work with docker compose) ───────────────────────
DATABASE_URL=postgresql+psycopg://veritas:veritas@db:5432/veritas
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Embeddings are local ONNX (fastembed / BAAI bge-small-en-v1.5) and never
# require a key or network access. This is deliberate — see docs/adr/.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Ports ────────────────────────────────────────────────────────────────────
# Override if something already owns these on your machine. The app is
# self-consistent: change API_PORT and the web UI follows it automatically.
API_PORT=8000
WEB_PORT=3000
DB_PORT=5432
